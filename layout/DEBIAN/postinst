#!/bin/sh
# 安装后自动重启桌面，省得手动 respring。三条路径依次兜底，全部失败也不让 dpkg 报错。
if [ -x /var/jb/usr/bin/sbreload ]; then
    /var/jb/usr/bin/sbreload >/dev/null 2>&1 || true
elif command -v sbreload >/dev/null 2>&1; then
    sbreload >/dev/null 2>&1 || true
else
    killall -9 SpringBoard >/dev/null 2>&1 || true
fi
exit 0
